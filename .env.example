# CivicConnect - environment variable names (no values, ever).
# The app does NOT load a .env file: set these in your shell or your host's secret store.
# See the Configuration table in README.md for defaults and rules.

# --- Application ---
SECRET_KEY=
DATABASE_URL=
SESSION_COOKIE_SECURE=
PASSWORD_HASH_COST=

# --- Optional first accounts (email and password must be set together) ---
BOOTSTRAP_REQUESTER_EMAIL=
BOOTSTRAP_REQUESTER_PASSWORD=
BOOTSTRAP_STAFF_EMAIL=
BOOTSTRAP_STAFF_PASSWORD=
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Email outbox ---
OUTBOX_WORKER_ENABLED=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
OUTBOX_WORKER_POLL_SECONDS=

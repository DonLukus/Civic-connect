# CivicConnect — environment configuration template
# The application does NOT read a .env file (no dotenv package is installed): set these in your shell
# or your host's secret store. Never commit real values or a .env file (see .gitignore).
# Names only here, per the M2 documentation guideline — no real values, ever, even placeholders
# that look real.

# --- Application ---
FLASK_ENV=
SECRET_KEY=

# --- Database (ADR-001: SQLite for dev/test, PostgreSQL free tier is the production candidate) ---
DATABASE_URL=

# --- Auth (DEC-006: authenticated submission only) ---
SESSION_COOKIE_SECURE=
PASSWORD_HASH_COST=
BOOTSTRAP_REQUESTER_EMAIL=
BOOTSTRAP_REQUESTER_PASSWORD=

# Bootstrap accounts are optional; provision demo users only from environment secrets.
BOOTSTRAP_STAFF_EMAIL=
BOOTSTRAP_STAFF_PASSWORD=
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Outbox / notifications (ADR-004) ---
OUTBOX_WORKER_ENABLED=
OUTBOX_WORKER_POLL_SECONDS=
APP_BASE_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
